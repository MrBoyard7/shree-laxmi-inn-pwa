# Copy this file to .env and fill in your own Firebase project's values.
# Without this file, the app runs fully client-side in "local demo mode"
# (see README.md), which is fine for evaluating the code but not for
# real guests, since admin edits then only live in one browser.

# Firebase project config (Project settings > General > Your apps > SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only used when the Firebase variables above are left empty (local demo
# mode). Change these away from the defaults before sharing a preview
# link with anyone.
VITE_DEMO_ADMIN_EMAIL=admin@shreelaxmiinn.example
VITE_DEMO_ADMIN_PASSWORD=ayodhya-demo
